# Copy this file to .env and replace the placeholder values.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters
COOKIE_SECURE=false
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Optional: use PostgreSQL/MySQL in production instead of SQLite.
# DATABASE_URL=sqlite:///./data/nexus.db
